# ---- 部署 / 数据 / 敏感信息（本地部署加固补充） ----
# 环境配置：含 DB 连接串与令牌，严禁入库；仅保留 .env.example 作为模板
.env
.env.*
!.env.example

# PostgreSQL 实体数据目录（erp_db 真实数据，非源码，体积巨大）
.pgdata/
.pgdata

# 本地数据库备份 dumps（迁移前手备，非源码，体积大，严禁入库）
backups/

# WorkBuddy 项目数据（非源码）
.workbuddy/

# 运行日志
logs/
*.log

# 源码导出 ZIP 产物（导出脚本产物，非仓库内容）
*.zip

# 缓存
.cache/

# lark-apaas IDE 工程元数据（非源码）
.spark/
.spark_project

# 测试构建产物
dist-test/
