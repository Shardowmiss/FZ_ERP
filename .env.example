# Logger
LOG_DIR=./logs

# ============ 本地数据库连接 ============
# 指向本地已运行的 postgres@16（端口 5434），库 pos_db。
SUDA_DATABASE_URL=postgres://erp:erp@localhost:5434/pos_db
# 平台内网 API 域名（本地绕过网关时指定；与 ERP 错开端口避免互相干扰）
FORCE_AUTHN_INNERAPI_DOMAIN=http://localhost:3100
# ⚠️ 请求/响应体日志会把登录密码、会员 PII、支付信息等敏感数据明文写盘。
# 平台 configureApp 消费此开关、应用层无法注入脱敏，故默认关闭。
# 仅临时调试需要时可置 true，且禁止在生产/含真实数据的环境开启。
LOG_REQUEST_BODY=false
LOG_RESPONSE_BODY=false

# ============ 服务监听端口（避免 ERP/POS 端口冲突） ============
# ERP 监听 3000；POS 在本机改用 3001，二者可同时启动互不抢占。
# ERP_UPSTREAM_BASE_URL 仍指向 ERP 的 3000，无需改动。
SERVER_PORT=3001

# ============ POS 本地鉴权（P0-1 启用后的开发旁路） ============
# 启用 AuthGuard 后，所有写接口要求携带服务端签发的 Bearer 令牌。
# 本地/联调无服务端登录可达时，置 true 临时旁路鉴权（仅限非生产环境，P1-6 已加固：
# 生产环境即便误设此开关也绝不旁路）；
# 生产环境必须删除 POS_AUTH_DISABLED 行，并配置 POS_AUTH_SECRET（>=16 位），
# 否则令牌可被伪造。main.ts 已在 production 下对缺失 POS_AUTH_SECRET 做启动期 fail-fast 校验。
POS_AUTH_DISABLED=false
POS_AUTH_SECRET=<请填入你的值，禁止提交真实值>

# ============ POS → ERP 上行鉴权（P0-2） ============
# 与 ERP 侧 ERP_UPSTREAM_TOKEN 完全一致的共享密钥（由 RealErpAdapter 随请求发送
# X-Erp-Upstream-Token 头）。两端须同步部署。
ERP_UPSTREAM_TOKEN=<请填入你的值，禁止提交真实值>
# ERP 接收端基址。适配器会再拼 /api/pos-receiver/...。
# ⚠️ 直连 ERP node（不走网关）时，ERP 把接口挂在全局前缀 CLIENT_BASE_PATH 之下，
# 此处必须带该前缀（本机 ERP=http://localhost:3000/client）；若走外层网关转发 /api，则可不带。
ERP_UPSTREAM_BASE_URL=http://localhost:3000/client

# ERP 库直连串（RealErpAdapter 的**下行** get* 方法使用：读款式/颜色/尺码/会员/
# 库存/调拨/价格/促销等主数据）。与上方上行 HTTP 是两条独立通道：
#   下行 = POS 直连 ERP 库（只读 SELECT）；上行 = POS 调 ERP HTTP 接收端。
# 不配置时 RealErpAdapter 会回退到 postgres://erp:erp@localhost:5434/erp_db，
# 显式配置便于多环境切换（测试/预发指向各自 ERP 库）。
ERP_DATABASE_URL=postgres://erp:erp@localhost:5434/erp_db

# ============ 本地 dev 前端挂载基路径（关键，同 ERP） ============
# 详见 ERP .env 注释。POS 前端挂在 :5174/client/，basename 必须与之对齐。
CLIENT_BASE_PATH=/client

# ============ 模板 fullstack 本地 dev 开关（同 ERP） ============
MIAODA_APP_TYPE=3
MIAODA_LOCAL_DEV=1

# ============ ERP↔POS 真实打通（#755） ============
# 本项目已从 MockErpService（硬编码假数据）切换为 RealErpAdapter，
# 上下行分两条独立通道，配置项互不相同，缺一不可：
#
# 【上行】POS → ERP，真实 HTTP 推送单据（销售/退货/盘点/要货/日结）
#   ERP_UPSTREAM_BASE_URL  ERP 接收端基址。
#         ⚠ ERP 把接口挂在全局前缀 CLIENT_BASE_PATH 之下，直连 node 时
#           必须带该前缀（本机为 http://localhost:3000/client）；
#           若走外层网关转发 /api 则可不带。
#           适配器会再拼 /api/pos-receiver/{sales|returns|stocktakes|
#           transfer-requests|eods}，此段勿重复填写。
#   ERP_UPSTREAM_TOKEN     与 ERP 侧 ERP_UPSTREAM_TOKEN 完全一致的共享密钥，
#           随 X-Erp-Upstream-Token 头发送，两端须同步部署。
#
# 【下行】POS ← ERP，直连 ERP 数据库只读拉主数据
#   ERP_DATABASE_URL      ERP 库连接串，仅 SELECT。
#           用于 getStyles/getColors/getSizes/getMembers/getPrices/
#           getPromotions/getStock/getTransfers。
#           不配置时回退 postgres://erp:erp@localhost:5434/erp_db，
#           显式配置便于测试/预发指向各自 ERP 库。
#
# 【门店编码映射】上行的 storeCode 必须在 ERP 侧可解析，否则返回
#   400「无法解析门店编码」。ERP 解析顺序：
#     ① pos_store_map.store_code 精确匹配  ② store.code 直接匹配
#   本机映射：POS 'STORE01' / 'HZ-HB-YT-001' → ERP 'ST0061 杭州银泰旗舰店'
#   新增门店时必须在 ERP 侧补 pos_store_map，否则该门店上行全失败。
