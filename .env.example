# ============================================================================
# ERP 云端部署环境变量模板（豆包 aiforce.run / 任意 Node 平台通用）
# 复制为 .env 后填入真实值；在云平台「环境变量」面板中逐项设置亦可（推荐）。
# 注意：本文件不含真实密码，可入库。真实 .env 已被 _export_zip.py 排除，切勿提交。
# ============================================================================

# ---- 必填①：数据库连接（Nest 启动期 onModuleInit 会写 RBAC 种子，连不上即中止启动）----
# 云端必须指向“可达”的 PostgreSQL（云厂商 RDS / Supabase / Aiven 等），不能用 localhost。
# 例：postgres://erp_user:password@db.xxx.rds.amazonaws.com:5432/erp_db
SUDA_DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/erp_db

# ---- 必填②：平台基础域名（lark-apaas PlatformHttpClientService 依赖注入阶段强制要求）----
# 缺失会直接报错 “平台模式需要基础域名，请设置环境变量 FORCE_AUTHN_INNERAPI_DOMAIN” 并中止启动。
# 非飞书/豆包原生集成场景填任意可达 URL 占位即可，例如 https://placeholder.local
FORCE_AUTHN_INNERAPI_DOMAIN=https://placeholder.local

# ---- 端口（平台通常自动注入 PORT；不注入时可用 SERVER_PORT 覆盖，兜底 3000）----
# PORT=3000
# SERVER_PORT=3000

# ---- 监听地址（默认 0.0.0.0，云平台必须对外暴露，勿改 localhost）----
# SERVER_HOST=0.0.0.0

# ---- 可选：日志目录（进程工作目录相对路径，需可写）----
LOG_DIR=./logs
LOG_REQUEST_BODY=false
LOG_RESPONSE_BODY=false

# ---- 可选：ERP→POS 上游回调相关（仅启用 POS 下行推送时才需要）----
# ERP_UPSTREAM_TOKEN=
# ERP_RECEIVER_ALLOWED_IPS=

# ---- 可选：应用层自签 CSRF 签名密钥（D.1）----
# HMAC-SHA256 密钥，仅服务端持有，用于签发/校验 erp-csrf 令牌（平台 double-submit
# 之上的增强）。生产环境必须配置强随机值（>=16 位），缺失则启动拒绝（fail closed）。
# 本地开发缺省会自动使用每进程随机密钥（重启失效，仅本地联调）。
# ERP_CSRF_SIGNING_SECRET=

# ---- 可选：字段级加密主密钥（P0-2 会员 PII 加密）----
# AES-256-GCM 加密 + HMAC-SHA256 查询列的共同主密钥（运行时会从中派生两个独立子密钥）。
# 长度必须 >= 32 字节（256 位）；生产缺失/弱即启动拒绝（fail-fast）。
# 生成：openssl rand -hex 32。通过部署密钥管理下发，切勿提交真实值。
# 本地开发缺省会自动使用不安全的开发兜底密钥（仅限本地，数据不可在 prod 解密）。
# FIELD_ENC_KEY=
